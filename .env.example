# SENTINEL Environment Configuration
# Copy to .env and fill in your values

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sentinel_analytics

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=sentinel

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM Providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Groq (Free tier, very fast LPU, Llama-3.1-70B)
# Get API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local LLM - free, unlimited, runs locally)
# Enable with: OLLAMA_ENABLED=true
# Install: brew install ollama && ollama pull llama3.1:8b
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Tribunal
TRIBUNAL_CONFIDENCE_THRESHOLD=0.7
TRIBUNAL_MAX_ROUNDS=3
TRIBUNAL_CITATION_REQUIRED=true

# Fraud Sentinel
FRAUD_DETECTION_WINDOW_MINUTES=60
FRAUD_MIN_CLUSTER_SIZE=3
FRAUD_SIMILARITY_THRESHOLD=0.85

# Policy Synthesis
POLICY_MAX_EXECUTION_TIME_SECONDS=300
POLICY_MAX_RETRIES=3

# Audit
AUDIT_MERKLE_TREE_DEPTH=20
AUDIT_RETENTION_DAYS=2555

# Eval
EVAL_HARNESS_ENABLED=true

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sentinel
PROMETHEUS_PORT=9090